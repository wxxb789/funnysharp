<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Take FSharp.Core from the configured feed, never the SDK's bundled library pack: the two
         carry different package hashes, so a lock file recorded from the pack fails NU1403 on a
         runner whose SDK does not ship that exact pack. -->
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Output.fs" />
    <Compile Include="Proc.fs" />
    <Compile Include="Repo.fs" />
    <Compile Include="ActionPins.fs" />
    <Compile Include="DocsSnippets.fs" />
    <Compile Include="Inventory.fs" />
    <Compile Include="VerticalSlice.fs" />
    <Compile Include="ToolingVerify.fs" />
    <Compile Include="Performance.fs" />
    <Compile Include="PerformanceDocs.fs" />
    <Compile Include="ReproducibleBuilds.fs" />
    <Compile Include="Ruleset.fs" />
    <Compile Include="Compatibility.fs" />
    <Compile Include="ReleaseProtocol.fs" />
    <Compile Include="XmlBuildBindings.fs" />
    <Compile Include="ReleaseRun.fs" />
    <Compile Include="ReleaseVerifySource.fs" />
    <Compile Include="ReleaseVerifyArtifacts.fs" />
    <Compile Include="StableApiContracts.fs" />
    <Compile Include="ApiBaseline.fs" />
    <Compile Include="ReleaseVerify.fs" />
    <Compile Include="ReleaseProvenance.fs" />
    <Compile Include="Loc.fs" />
    <Compile Include="Evaluation.fs" />
    <Compile Include="FrozenReplay.fs" />
  </ItemGroup>

</Project>
