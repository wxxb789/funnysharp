<Project Sdk="Microsoft.NET.Sdk">

  <!-- Research prototype for Goal 0039. Not shipped, not packed, and not referenced by any
       shipping project. It recognizes a narrow static subset of existing FunnySharp
       Summary/Decoder field initializers and emits specialized execution for opt-in partial
       methods. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
