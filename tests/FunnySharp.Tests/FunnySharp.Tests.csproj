<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FunnySharp/FunnySharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/TestRepositoryRoot.cs" Link="Shared/TestRepositoryRoot.cs" />
    <Compile Include="../Shared/SharedOrderSupport.cs" Link="Shared/SharedOrderSupport.cs" />
    <Compile Include="../Shared/DecoderComparison/*.cs" Link="Shared/DecoderComparison/%(Filename)%(Extension)" />
    <Compile Include="../Shared/ContractComparison/*.cs" Link="Shared/ContractComparison/%(Filename)%(Extension)" />
    <Compile Include="../Shared/PatchComparison/*.cs" Link="Shared/PatchComparison/%(Filename)%(Extension)" />
    <Compile Include="../Shared/BatchComparison/*.cs" Link="Shared/BatchComparison/%(Filename)%(Extension)" />
    <Compile Include="../Shared/DomainComparison/*.cs" Link="Shared/DomainComparison/%(Filename)%(Extension)" />
    <Compile Include="../Shared/CheckComparison/*.cs" Link="Shared/CheckComparison/%(Filename)%(Extension)" />
    <Compile Include="../Shared/FallibleReduction/*.cs" Link="Shared/FallibleReduction/%(Filename)%(Extension)" />
    <Compile Include="../Shared/SummaryComparison/*.cs" Link="Shared/SummaryComparison/%(Filename)%(Extension)" />
    <Compile Include="../Shared/JoinComparison/*.cs" Link="Shared/JoinComparison/%(Filename)%(Extension)" />
    <Compile Include="../Shared/ValidationUnwrap.cs" Link="Shared/ValidationUnwrap.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
