<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The compatibility harness selects one lane per scenario with -p:TargetFramework. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FunnySharp" Version="$(FunnySharpPackageVersion)" />
    <PackageReference Include="FunnySharp.AspNetCore" Version="$(FunnySharpAspNetCorePackageVersion)" />
    <TrimmerRootAssembly Include="FunnySharp" Condition="'$(RootShippingAssemblies)' == 'true'" />
    <TrimmerRootAssembly Include="FunnySharp.AspNetCore" Condition="'$(RootShippingAssemblies)' == 'true'" />
  </ItemGroup>
</Project>
