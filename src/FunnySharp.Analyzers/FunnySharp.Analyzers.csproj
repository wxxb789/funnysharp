<Project Sdk="Microsoft.NET.Sdk">

  <!-- Analyzer and code-fix tooling for FunnySharp. Shipped inside the FunnySharp package under
       analyzers/dotnet/cs, so every package consumer gets compiler feedback with zero extra
       installs and no runtime dependency. netstandard2.0 + Roslyn 4.14 matches the .NET 10 SDK
       compiler; consumers must build with an SDK that ships Roslyn 4.14 or newer. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
