<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>FunnySharp</PackageId>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>FunnySharp contributors</Authors>
    <Description>Pragmatic, BCL-first functional programming for modern C#.</Description>
    <PackageTags>functional-programming;csharp;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/wxxb789/funnysharp</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/wxxb789/funnysharp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <EnablePackageValidation>true</EnablePackageValidation>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin the SDK's implicit trim-tasks reference so locked restores evaluate identically on
         every SDK patch; the implicit floor otherwise follows the runner's installed SDK. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Goal 21 compiler feedback: build the analyzers before this package so their outputs can be
         embedded under analyzers/dotnet/cs. ReferenceOutputAssembly keeps the analyzer assemblies
         out of the compile-time and runtime reference set: the package keeps an empty dependency
         group and consumers gain no runtime reference. -->
    <ProjectReference Include="../FunnySharp.Analyzers/FunnySharp.Analyzers.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../FunnySharp.Analyzers.CodeFixes/FunnySharp.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../FunnySharp.Analyzers/bin/$(Configuration)/netstandard2.0/FunnySharp.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../FunnySharp.Analyzers.CodeFixes/bin/$(Configuration)/netstandard2.0/FunnySharp.Analyzers.CodeFixes.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
